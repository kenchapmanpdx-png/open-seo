[Unit]
Description=OpenSEO Common Crawl backlink baseline (ADR-016)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@REPO@
# No Playwright build for this distro id; the sidecar CLI paths and ui-smoke need it.
Environment=PLAYWRIGHT_HOST_PLATFORM_OVERRIDE=ubuntu24.04-x64
ExecStart=/usr/bin/env pnpm exec tsx fork/scripts/commoncrawl-backlinks.ts
