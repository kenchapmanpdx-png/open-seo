[Unit]
Description=OpenSEO cron tick (fires Worker scheduled handlers)
After=openseo-app.service

[Service]
Type=oneshot
WorkingDirectory=@REPO@
# No Playwright build for this distro id; the sidecar CLI paths and ui-smoke need it.
Environment=PLAYWRIGHT_HOST_PLATFORM_OVERRIDE=ubuntu24.04-x64
ExecStart=/usr/bin/env bash fork/scripts/cron-tick.sh
